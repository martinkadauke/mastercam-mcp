# NET-Hook function table
#----------------------------------------------------------
# Name      MastercamMcp.Addin.ft
# NETHook   MastercamMcp.Addin.dll
#
# Notes     This file must remain beside the add in in the Mastercam chooks folder.
#----------------------------------------------------------

APPLICATION "MastercamMcp"
FUNC_DLL   "chooks\MastercamMcp.Addin.dll"
RES_DLL    "SAME"
dnRES_NAME "MastercamMcp.Addin.FunctionTable"
CATEGORY   "Add-Ins"

# Mastercam 2027 resolves FUNC_DLL from its root and needs dnRES_NAME (FunctionTable.resx) or it throws
FUNCTION NET "Run"
    FNAME  "Mastercam MCP"
    dnTIP  "RunTip"
END_FUNCTION
